# Токен бота от @BotFather
TELEGRAM_TOKEN=123456789:ABCdef...

# Бесплатный ключ Gemini с aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Твой Telegram ID (бот сам подскажет его при первом сообщении). Несколько — через запятую.
ALLOWED_USERS=

# Часовой пояс и валюта
TZ_NAME=Europe/Moscow
CURRENCY=₽

# Модели (можно не трогать)
CHAT_MODEL=gemini-flash-latest
SMART_MODEL=gemini-flash-latest
