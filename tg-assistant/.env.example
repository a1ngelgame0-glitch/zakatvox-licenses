# Токен бота от @BotFather
TELEGRAM_TOKEN=123456789:ABCdef...

# Ключ API с console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Твой Telegram ID (бот сам подскажет его при первом сообщении). Несколько — через запятую.
ALLOWED_USERS=

# Часовой пояс и валюта
TZ_NAME=Europe/Moscow
CURRENCY=₽

# Модели: дешёвая для чата и мощная для отчётов и планов
CHAT_MODEL=claude-haiku-5-5
SMART_MODEL=claude-opus-5-5
